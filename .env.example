# CARTO Basemaps API key. Sent with every raster tile request, so it is public
# whatever you do with it — restrict it by referrer in the CARTO dashboard
# rather than trying to hide it: https://carto.com/basemaps/apikey/
#
# Leave this unset and the key checked into src/lib/basemap.js is used.
PUBLIC_CARTO_KEY=

# Deploy target. See astro.config.mjs.
SITE_URL=
BASE_PATH=
