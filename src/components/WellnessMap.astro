---
/* The map itself: header, filter bar, list and Leaflet canvas.
 *
 * The stylesheet and the client script are imported here rather than in a page,
 * so dropping <WellnessMap /> into any route brings everything it needs with it.
 */
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import '../styles/wellness-map.css';

import { validateEntries } from '../lib/validate.js';

/* Runs on `astro build` and on every save in dev. A malformed listing stops the
   build with the id and the reason rather than shipping a broken pin. */
validateEntries();
---

<div id="app">
  <div id="map"><div class="tilewarn" id="tilewarn"></div></div>

  <!-- Everything that is not the map lives in one card floating over it. The
       head holds the filters and the count and never scrolls; the list moves
       underneath it. -->
  <section class="panel" aria-label="Places">
    <div class="panel-head">
      <div class="brand">
        <h1 class="wordmark">Bengaluru <span>Wellness</span> Map</h1>
        <p class="tagline">Where the city runs, lifts, swims, eats and gets looked after.</p>
        <span class="flag" id="flag"></span>
      </div>

      <input type="search" id="q" placeholder="Search name, area or tag" aria-label="Search" />

      <div class="iconbar" id="seg" role="group" aria-label="Category"></div>
      <div class="iconbar subs" id="sub" role="group" aria-label="Sub-category"></div>

      <div class="selects">
        <select id="rg" aria-label="Corporation"></select>
        <select id="area" aria-label="Area"></select>
      </div>

      <div class="switches">
        <div class="seg2" role="group" aria-label="View">
          <button id="v-map" aria-pressed="true">Map</button><button id="v-grid" aria-pressed="false">Grid</button>
        </div>
        <div class="seg2" role="group" aria-label="Map style">
          <button id="m-regions" aria-pressed="true">Regions</button><button id="m-plain" aria-pressed="false">Plain</button>
        </div>
        <div class="seg2" role="group" aria-label="Overlays">
          <button id="l-metro" aria-pressed="true">Metro</button><button id="l-parks" aria-pressed="true">Parks</button>
        </div>
        <span class="count" id="count"></span>
      </div>
    </div>

    <div class="panel-body" id="list">
      <div id="notice"></div>
      <div class="cards" id="cards"></div>
      <div class="foot" id="foot"></div>
    </div>
  </section>
</div>

<script>
  import '../scripts/wellness-map.js';
</script>
